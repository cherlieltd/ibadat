# ============================================================
# My Daily Ibadah — Environment Variables
# Copy this file to .env.local and fill in your values.
# ============================================================

# Demo mode (explicit). When true, the app uses local sample data
# and demo accounts instead of Supabase.
# Leave unset to auto-enable demo mode when Supabase is missing.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (required for production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: set to false once Supabase is configured
# NEXT_PUBLIC_DEMO_MODE=false
